# Copy this file to .env and fill in your values.
# After running scripts/setup_db.py, the values below work as-is.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=decisiontrace
POSTGRES_USER=dtuser
POSTGRES_PASSWORD=dtpassword

DATABASE_URL=postgresql://dtuser:dtpassword@localhost:5432/decisiontrace

PREFECT_API_URL=http://localhost:4200/api

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Data directories
RAW_DATA_DIR=data/raw
VALIDATED_DATA_DIR=data/validated
SIMULATED_DATA_DIR=data/simulated

# Freshness threshold — hours before a source is considered stale
FRESHNESS_THRESHOLD_HOURS=24
